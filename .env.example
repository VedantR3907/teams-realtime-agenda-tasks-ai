# Copy to .env and fill in. Never commit the real .env.
ENVIRONMENT=development

# LLM provider: "gemini" or "openai"
MODEL_PROVIDER=gemini
GEMINI_API_KEY=<your-gemini-api-key>
OPENAI_API_KEY=<your-openai-api-key>

# Speech-to-text (Deepgram)
DEEPGRAM_API_KEY=<your-deepgram-api-key>

# Meeting platform backend (Socket.IO + REST) and shared signing key
SOCKET_URL=<your-platform-backend-url>
SECRET_KEY=<shared-secret-for-socket-tokens>

# Service that posts task cards (Adaptive Cards) in Microsoft Teams
ADAPTIVE_CARD_SERVER_URL=<your-notification-service-url>

# Azure AD app (client credentials) used to call the platform API
CLIENT_ID=<your-azure-app-client-id>
CLIENT_SECRET=<your-azure-app-client-secret>
TENANT_ID=<your-azure-tenant-id>

# Local Teams media bot
BOT_JOIN_URL=http://localhost:9442
BOT_WORKING_DIRECTORY=C:/meeting-bot

# JWT for this service's own API
JWT_SECRET_KEY=<long-random-string>

# Optional: AWS CloudWatch logging
CW_ENABLED=false
AWS_REGION=eu-central-1
CW_LOG_GROUP=meeting-agenda-tasks-ai
